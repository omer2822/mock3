{
  "name": "live-poll-dashboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @live-poll/web",
    "dev:api": "npm run dev -w @live-poll/api",
    "build": "npm run build -w @live-poll/web && npm run build -w @live-poll/api",
    "lint": "npm run lint -w @live-poll/web && npm run lint -w @live-poll/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "playwright": "^1.59.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}
